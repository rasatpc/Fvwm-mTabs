DEFAULT_THEME_COLOUR = "#222222"

class _Palette(dict):
    """A colour palette that returns the neutral default for any unset element."""

    def __missing__(self, element):
        return DEFAULT_THEME_COLOUR

# Active palettes used by the UI at runtime, populated by _load_config().
THEMES = {}

def _install_themes(themes):
    """Publish the conf-derived palettes as the module global THEMES."""
    global THEMES
    THEMES = themes

