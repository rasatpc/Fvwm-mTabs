def _select_window():
    # xdotool/X11 chooses the cursor shown here; there is no reliable plain
    # "+" cursor option to set from this script.
    try:
        raw = _run_capture(["xdotool", "selectwindow"], timeout=SELECT_WINDOW_TIMEOUT).strip()
        return int(raw, 0)
    except Exception:
        return None


def _extract_window_ids(raw):
    windows = set()
    for token in raw.replace(",", " ").split():
        token = token.strip().rstrip(".,;")
        if not token.startswith("0x"):
            continue
        try:
            win_id = int(token, 16)
        except Exception:
            continue
        if win_id:
            windows.add(win_id)
    return windows


def _log_client_list_unavailable():
    global _LAST_CLIENT_LIST_UNAVAILABLE_LOG
    now = time.monotonic()
    if now - _LAST_CLIENT_LIST_UNAVAILABLE_LOG < LOG_THROTTLE_SECONDS:
        return
    _LAST_CLIENT_LIST_UNAVAILABLE_LOG = now


def _client_snapshot_available(details):
    return bool(details) and any(prop_details["available"] for prop_details in details.values())


def _get_client_window_snapshot():
    details = {
        prop: {"available": False, "windows": set(), "raw": ""}
        for prop in CLIENT_LIST_PROPERTIES
    }
    try:
        out = _run_capture(
            ["xprop", "-root", *CLIENT_LIST_PROPERTIES],
            timeout=CLIENT_LIST_COMMAND_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        _log_client_list_unavailable()
        return set(), details
    except Exception:
        chunks = []
        for prop in CLIENT_LIST_PROPERTIES:
            try:
                chunks.append(_run_capture(
                    ["xprop", "-root", prop],
                    timeout=CLIENT_LIST_COMMAND_TIMEOUT,
                ))
            except Exception:
                pass
        if not chunks:
            _log_client_list_unavailable()
            return set(), details
        out = "\n".join(chunks)

    for line in out.splitlines():
        stripped = line.strip()
        key = _xprop_key(stripped)
        if key not in details:
            continue
        if details[key]["raw"]:
            details[key]["raw"] += "\n" + stripped
        else:
            details[key]["raw"] = stripped

    windows = set()
    for prop, prop_details in details.items():
        raw = prop_details["raw"]
        lowered = raw.lower()
        if not raw or "not found" in lowered or "no such atom" in lowered:
            continue
        prop_details["available"] = True
        prop_details["windows"] = _extract_window_ids(raw)
        windows.update(prop_details["windows"])

    if not any(prop_details["available"] for prop_details in details.values()):
        _log_client_list_unavailable()

    return windows, details


def _list_client_windows():
    windows, _details = _get_client_window_snapshot()
    return windows


def _list_existing_x_windows(timeout=CLIENT_LIST_COMMAND_TIMEOUT):
    try:
        out = _run_capture(["xwininfo", "-root", "-tree"], timeout=timeout)
    except Exception:
        return None
    windows = _extract_window_ids(out)
    return windows


# WindowWatcher turns root-window client-list changes into Tk-thread queue
# events. All reparenting still happens on the Tk/server thread. It backs off
# when the client list is stable so an idle desktop is not kept hot by xprop.
class WindowWatcher(threading.Thread):
    def __init__(
        self,
        enqueue,
        stop_event,
        min_interval=WATCH_MIN_INTERVAL,
        max_interval=WATCH_MAX_INTERVAL,
        backoff_factor=WATCH_BACKOFF_FACTOR,
    ):
        super().__init__(daemon=True)
        self.enqueue = enqueue
        self.stop_event = stop_event
        self.min_interval = max(WATCH_MIN_SLEEP, float(min_interval))
        self.max_interval = max(self.min_interval, float(max_interval))
        self.backoff_factor = max(1.0, float(backoff_factor))
        self.interval = self.min_interval
        self.known, self.details = _get_client_window_snapshot()

    def run(self):
        while not self.stop_event.is_set():
            started = time.monotonic()
            current, details = _get_client_window_snapshot()
            snapshot_at = time.monotonic()
            if not _client_snapshot_available(details):
                elapsed = time.monotonic() - started
                self.interval = min(self.max_interval, max(self.min_interval, self.interval * self.backoff_factor))
                self.stop_event.wait(max(WATCH_MIN_SLEEP, self.interval - elapsed))
                continue

            new_windows = current - self.known
            removed_windows = self.known - current
            if new_windows or removed_windows:
                self.enqueue("watch_windows", (current, new_windows, removed_windows, details, snapshot_at))
                self.interval = self.min_interval
            else:
                self.interval = min(self.max_interval, max(self.min_interval, self.interval * self.backoff_factor))
            self.known = current
            self.details = details
            elapsed = time.monotonic() - started
            wait_seconds = max(WATCH_MIN_SLEEP, self.interval - elapsed)
            self.stop_event.wait(wait_seconds)


class Tab:
    """Bookkeeping for one client window inside a tabber."""

    def __init__(self, win_id, title, frame, button, close_button, width=None, height=None):
        self.win_id = win_id
        self.title = title
        self.frame = frame
        self.button = button
        self.close_button = close_button
        self.width = width
        self.height = height


class Tabber:
    """Small Tk shell that owns the tab UI and the X11 tab lifecycle."""

    def __init__(
        self,
        root,
        tabber_id,
        theme_name="black",
        geometry=None,
        on_destroy=None,
        on_active=None,
        on_window_released=None,
        request_new_tabber=None,
        request_add_loop=None,
        request_command=None,
    ):
        self.root = root
        self.tabber_id = tabber_id
        self.on_destroy = on_destroy
        self.on_active = on_active
        self.on_window_released = on_window_released
        self.request_new_tabber = request_new_tabber
        self.request_add_loop = request_add_loop
        self.request_command = request_command
        self.tabs = []
        self.current = None
        self.theme_name = theme_name if theme_name in THEMES else "black"
        self._keepalive_job = None
        self._menu_visible = False
        self._resize_job = None
        self._last_resize_request = None

        self.resource_name = f"{TABBER_RESOURCE_PREFIX}{tabber_id}"
        self.window_title = f"{TABBER_WINDOW_CLASS} [{tabber_id}]"
        self.top = tk.Toplevel(root, name=self.resource_name, class_=TABBER_WINDOW_CLASS)
        self.top.title(self.window_title)
        self.top.geometry(geometry or DEFAULT_GEOMETRY)

        self.tabbar = tk.Frame(self.top, highlightthickness=0, bd=0)
        self.tabbar.pack(side="top", fill="x")

        self.menu_button = tk.Button(
            self.tabbar,
            text="v",
            relief="flat",
            bd=0,
            padx=8,
            pady=2,
            command=self._toggle_dropdown,
        )
        self.menu_button.pack(side="right", padx=2, pady=2)

        self.tabs_holder = tk.Frame(self.tabbar, highlightthickness=0, bd=0)
        self.tabs_holder.pack(side="left", fill="x", expand=True)

        self.content = tk.Frame(self.top, highlightthickness=0, bd=0)
        self.content.pack(side="top", fill="both", expand=True)
        self.content.bind("<Configure>", self._on_resize)

        self._dropdown = tk.Menu(self.top, tearoff=0)
        self._dropdown.bind("<Unmap>", self._on_menu_unmap, add="+")
        self._dropdown.bind("<ButtonRelease-1>", self._on_menu_click, add="+")

        self.top.protocol("WM_DELETE_WINDOW", self.destroy)
        self.top.bind("<ButtonPress-1>", self._dismiss_menu, add="+")
        self.top.bind("<FocusIn>", self._on_focus_in, add="+")
        self.root.bind_all("<ButtonPress>", self._on_global_button_press, add="+")

        self._apply_theme()

    def _configure_menu_widget(self, menu):
        theme = THEMES[self.theme_name]
        menu.configure(
            bg=theme["menu_bg"],
            fg=theme["menu_fg"],
            activebackground=theme["menu_active_bg"],
            activeforeground=theme["menu_active_fg"],
            bd=1,
            relief="flat",
        )

    def _apply_theme(self):
        theme = THEMES[self.theme_name]
        self.top.configure(bg=theme["tabbar_bg"])
        self.tabbar.configure(bg=theme["tabbar_bg"])
        self.tabs_holder.configure(bg=theme["tabbar_bg"])
        self.content.configure(bg=theme["content_bg"])
        self._configure_menu_widget(self._dropdown)
        self.menu_button.configure(
            bg=theme["button_bg"],
            fg=theme["button_fg"],
            activebackground=theme["button_active_bg"],
            activeforeground=theme["button_active_fg"],
        )
        self._apply_theme_to_tabs()

    def _apply_theme_to_tabs(self):
        theme = THEMES[self.theme_name]
        for index, tab in enumerate(self.tabs):
            selected = index == self.current
            button_bg = theme["button_selected_bg"] if selected else theme["button_bg"]
            button_fg = theme["button_selected_fg"] if selected else theme["button_fg"]
            border = theme["button_selected_border"] if selected else theme["tabbar_bg"]
            tab.frame.configure(
                bg=theme["tabbar_bg"],
                highlightbackground=border,
                highlightcolor=border,
            )
            tab.button.configure(
                bg=button_bg,
                fg=button_fg,
                activebackground=theme["button_active_bg"],
                activeforeground=theme["button_active_fg"],
            )
            tab.close_button.configure(
                bg=button_bg,
                fg=theme["close_fg"] if not selected else button_fg,
                activebackground=theme["button_active_bg"],
                activeforeground=theme["button_active_fg"],
            )

    def activate(self):
        self._mark_active("activate")
        try:
            self.top.deiconify()
            self.top.lift()
            self.top.focus_force()
            self.top.update_idletasks()
        except Exception:
            pass

    def _parent_id(self):
        self.top.update_idletasks()
        return self.content.winfo_id()

    def _on_resize(self, _event=None):
        if self.current is None or self.current >= len(self.tabs):
            return
        win_id = self.tabs[self.current].win_id
        size = (max(1, self.content.winfo_width()), max(1, self.content.winfo_height()))
        if self._last_resize_request == (win_id, size):
            return
        self._last_resize_request = (win_id, size)
        if self._resize_job is not None:
            try:
                self.top.after_cancel(self._resize_job)
            except Exception:
                pass
        self._resize_job = self.top.after(RESIZE_DEBOUNCE_MS, self._flush_resize)

    def _flush_resize(self):
        self._resize_job = None
        if self.current is None or self.current >= len(self.tabs):
            return
        self._resize_window(self.tabs[self.current].win_id)

    def _resize_window(self, win_id):
        width = max(1, self.content.winfo_width())
        height = max(1, self.content.winfo_height())
        return _xdo("windowsize", win_id, width, height)

    def _focus_window(self, win_id):
        raised = _xdo("windowraise", win_id)
        focused = _xdo("windowfocus", win_id)
        return raised and focused

    def _set_outer_geometry(self, width, height):
        tabbar_h = max(1, self.tabbar.winfo_height() or 28)
        size = f"{max(1, width)}x{max(1, height + tabbar_h)}"
        try:
            x = self.top.winfo_x()
            y = self.top.winfo_y()
            self.top.geometry(f"{size}+{x}+{y}")
        except Exception:
            self.top.geometry(size)

    def _resize_outer_for_tab(self, tab):
        width = tab.width or max(1, self.content.winfo_width() or 170)
        height = tab.height or max(1, self.content.winfo_height() or 40)
        self._set_outer_geometry(width, height)

    def remove_missing_windows(self, existing_windows):
        if existing_windows is None:
            return 0
        dead = []
        for index, tab in enumerate(self.tabs):
            if tab.win_id not in existing_windows:
                dead.append(index)
        for index in reversed(dead):
            self._remove_tab(index, release=False)
        return len(dead)

    def _dismiss_menu(self, _event=None):
        if not self._menu_visible:
            return
        try:
            self._dropdown.unpost()
        except Exception:
            pass
        self._menu_visible = False

    def _on_menu_unmap(self, _event=None):
        self._menu_visible = False

    def _on_menu_click(self, _event=None):
        self.top.after_idle(self._dismiss_menu)

    def _mark_active(self, source):
        if self.on_active:
            self.on_active(self.tabber_id, source)

    def _on_focus_in(self, event=None):
        self._mark_active("focus")
        self._dismiss_menu(event)

    def _on_global_button_press(self, event):
        if not self._menu_visible:
            return
        widget_path = str(event.widget)
        menu_path = str(self._dropdown)
        if not widget_path.startswith(menu_path) and event.widget is not self.menu_button:
            self._dismiss_menu()

    def _toggle_dropdown(self):
        if self._menu_visible:
            self._dismiss_menu()
            return
        self._show_dropdown()

    def _show_dropdown(self):
        self._mark_active("dropdown")
        self._dismiss_menu()
        self._dropdown.delete(0, "end")
        self._dropdown.add_command(label="New Tabber", command=self._menu_new_tabber)
        self._dropdown.add_command(label="Add Window(s)", command=self._menu_add_windows)
        self._dropdown.add_command(label="Kill", command=self._menu_kill_current)
        self._dropdown.add_command(label="Next Tab", command=self._menu_next_tab)
        self._dropdown.add_command(label="Prev Tab", command=self._menu_prev_tab)
        self._dropdown.add_command(label="Destroy Tabber", command=self._menu_destroy_tabber)

        bx = self.menu_button.winfo_rootx()
        by = self.menu_button.winfo_rooty() + self.menu_button.winfo_height()
        self._dropdown.post(bx, by)
        self._menu_visible = True

    def _menu_new_tabber(self):
        self._mark_active("dropdown-command")
        self._dismiss_menu()
        if self.request_command:
            self.request_command("NewTabber", [], source="dropdown")
        elif self.request_new_tabber:
            self.request_new_tabber()

    def _menu_add_windows(self):
        self._mark_active("dropdown-command")
        self._dismiss_menu()
        if self.request_command:
            self.request_command("Tabize", [str(self.tabber_id)], source="dropdown")
        elif self.request_add_loop:
            self.request_add_loop(self.tabber_id)

    def _menu_kill_current(self):
        self._mark_active("dropdown-command")
        self._dismiss_menu()
        if self.current is None or self.current >= len(self.tabs):
            return
        self.kill_tab(self.tabs[self.current].win_id)

    def _menu_next_tab(self):
        self._mark_active("dropdown-command")
        self._dismiss_menu()
        if self.request_command:
            self.request_command("NextTab", [str(self.tabber_id)], source="dropdown")
        else:
            self.next_tab()

    def _menu_prev_tab(self):
        self._mark_active("dropdown-command")
        self._dismiss_menu()
        if self.request_command:
            self.request_command("PrevTab", [str(self.tabber_id)], source="dropdown")
        else:
            self.prev_tab()

    def _menu_destroy_tabber(self):
        self._mark_active("dropdown-command")
        self._dismiss_menu()
        if self.request_command:
            self.request_command("DestroyTabber", [str(self.tabber_id)], source="dropdown")
        else:
            self.destroy()

    def _tab_frame(self, title, win_id):
        frame = tk.Frame(self.tabs_holder, highlightthickness=1, bd=0)
        button = tk.Button(
            frame,
            text=title or str(win_id),
            command=lambda: self.select_by_id(win_id),
            relief="flat",
            bd=0,
            padx=8,
            pady=2,
        )
        button.pack(side="left")

        close_button = tk.Button(
            frame,
            text="x",
            command=lambda: self.release_tab(win_id),
            relief="flat",
            bd=0,
            padx=6,
            pady=2,
        )
        close_button.pack(side="left")
        frame.pack(side="left", padx=2, pady=2)

        button.bind("<Button-3>", lambda _event, w=win_id: self.rename_tab(w))
        return frame, button, close_button

    def add_window(self, win_id, title):
        for existing in self.tabs:
            if existing.win_id == win_id:
                self.select_by_id(win_id)
                return True

        width, height = _get_window_geometry(win_id)
        parent_id = self._parent_id()
        self.activate()
        if not _xdo("windowreparent", win_id, parent_id):
            return False

        frame, button, close_button = self._tab_frame(title, win_id)
        tab = Tab(win_id, title or str(win_id), frame, button, close_button, width=width, height=height)
        self.tabs.append(tab)

        _xdo("windowmap", win_id)

        self._apply_theme_to_tabs()
        self.top.update_idletasks()
        if not self.select_index(len(self.tabs) - 1):
            self._rollback_add_window(tab)
            return False

        return True

    def _rollback_add_window(self, tab):
        try:
            root_id = _get_root_window_id()
            if root_id is not None:
                _xdo("windowreparent", tab.win_id, root_id)
                _xdo("windowmap", tab.win_id)
        except Exception:
            pass
        try:
            tab.frame.destroy()
        except Exception:
            pass
        try:
            self.tabs.remove(tab)
        except ValueError:
            pass
        self.current = None if not self.tabs else min(self.current or 0, len(self.tabs) - 1)
        self._apply_theme_to_tabs()

    def select_by_id(self, win_id):
        for index, tab in enumerate(self.tabs):
            if tab.win_id == win_id:
                return self.select_index(index)
        return False

    def select_index(self, idx):
        if idx < 0 or idx >= len(self.tabs):
            return False

        if self.current is not None and self.current != idx and self.current < len(self.tabs):
            old = self.tabs[self.current].win_id
            _xdo("windowunmap", old)

        self.current = idx
        tab = self.tabs[idx]
        self.activate()
        self._resize_outer_for_tab(tab)
        _xdo("windowmap", tab.win_id)
        self._resize_window(tab.win_id)
        self._focus_window(tab.win_id)
        self._apply_theme_to_tabs()
        return True

    def next_tab(self):
        if not self.tabs:
            return
        if self.current is None:
            self.select_index(0)
            return
        self.select_index((self.current + 1) % len(self.tabs))

    def prev_tab(self):
        if not self.tabs:
            return
        if self.current is None:
            self.select_index(0)
            return
        self.select_index((self.current - 1) % len(self.tabs))

    def rename_tab(self, win_id):
        for tab in self.tabs:
            if tab.win_id != win_id:
                continue
            new_name = simpledialog.askstring(
                "Rename Tab",
                "Tab name:",
                initialvalue=tab.title,
                parent=self.top,
            )
            if new_name:
                tab.title = new_name
                tab.button.configure(text=new_name)
            return

    def _remove_tab(self, idx, release=True):
        if idx < 0 or idx >= len(self.tabs):
            return

        tab = self.tabs[idx]
        if release:
            if self.on_window_released:
                self.on_window_released(tab.win_id, "manual-release")
            root_id = _get_root_window_id()
            if root_id is not None:
                _xdo("windowunmap", tab.win_id)
                _xdo("windowreparent", tab.win_id, root_id)
                _xdo("windowmap", tab.win_id)

        try:
            tab.frame.destroy()
        except Exception:
            pass

        self.tabs.pop(idx)
        if self.current is not None:
            if self.current == idx:
                self.current = None
                if self.tabs:
                    self.select_index(min(idx, len(self.tabs) - 1))
            elif self.current > idx:
                self.current -= 1
        self._apply_theme_to_tabs()

    def release_tab(self, win_id):
        for idx, tab in enumerate(self.tabs):
            if tab.win_id == win_id:
                self._remove_tab(idx, release=True)
                return

    def kill_tab(self, win_id):
        if not _xdo("windowkill", win_id):
            _xdo("windowclose", win_id)
        for idx, tab in enumerate(self.tabs):
            if tab.win_id == win_id:
                self._remove_tab(idx, release=False)
                return

    def has_window(self, win_id):
        return any(tab.win_id == win_id for tab in self.tabs)

    def release_all(self):
        for idx in reversed(range(len(self.tabs))):
            self._remove_tab(idx, release=True)

    def destroy(self):
        self._dismiss_menu()
        if self._resize_job is not None:
            try:
                self.top.after_cancel(self._resize_job)
            except Exception:
                pass
            self._resize_job = None
        if self._keepalive_job is not None:
            try:
                self.top.after_cancel(self._keepalive_job)
            except Exception:
                pass
            self._keepalive_job = None
        self.release_all()
        if self.on_destroy:
            self.on_destroy(self.tabber_id)
        try:
            self.top.destroy()
        except Exception:
            pass


# Server: socket command router, tabber registry, and autoSwallow coordinator.
class FvwmTabsServer:
    def __init__(self):
        self.config = _load_config(CONFIG_PATH)
        if not _import_tkinter():
            raise SystemExit(1)
        display = os.environ.get("DISPLAY", ":0")
        try:
            self.root = tk.Tk()
        except Exception as err:
            print(f"FvwmTabs: cannot open display {display!r}: {err}", file=sys.stderr)
            raise SystemExit(1)
        self.root.withdraw()
        self.default_theme = self.config["theme"]
        self.auto_swallow_class = self.config["auto_swallow_class"]
        self.auto_swallow_resource = self.config["auto_swallow_resource"]
        self.auto_swallow_name = self.config["auto_swallow_name"]
        self.auto_swallow_on_startup = self.config["auto_swallow_on_startup"]
        self.auto_create_assigned_tabber = self.config["auto_create_assigned_tabber"]
        self.tabbers = {}
        self.queue = queue.Queue()
        self._queue_drain_job = None
        self._queue_wake_read = None
        self._queue_wake_write = None
        self._queue_wake_filehandler = False
        self._draining_queue = False
        self.sock = None
        self._next_tabber_counter = 1
        self.active_tabber_id = None
        self._known_windows = _list_client_windows()
        self._pending_autoswallow = {}
        self._autoswallow_seen = {}
        self._autoswallow_suppressed = {}
        self._startup_scan_attempts = 0
        self._startup_scan_done = False
        self._startup_scan_job = None
        self._first_tabber_scan_done = False
        self._first_tabber_scan_job = None
        self._fallback_scan_job = None
        self._tabbed_window_sweep_job = None
        self._last_window_detection = time.monotonic()
        self._last_fvwmmfl_events = {}
        self._last_queued_fvwmmfl_events = {}
        self._fvwmmfl_nonclient_seen = {}
        self._fvwmmfl_started_at = time.monotonic()
        self._fvwmmfl_pending_probes = {}
        self._fvwmmfl_probe_job = None
        self._fvwmmfl_in_progress = set()
        self._fvwmmfl_failed_probe_seen = {}
        self._client_list_cache = None
        self._client_list_cache_details = None
        self._client_list_cache_at = 0.0
        self._selection_lock = threading.Lock()
        self._stop_event = threading.Event()
        self._setup_queue_wakeup()
        # When autoSwallow rules are active we need prompt window detection.
        # Cap the watcher's backoff at WATCH_MIN_INTERVAL so a new window is
        # seen within one poll cycle instead of up to WATCH_MAX_INTERVAL (2 s).
        _watch_max = (
            WATCH_MIN_INTERVAL if self._autoswallow_rules_configured()
            else WATCH_MAX_INTERVAL
        )
        self._watcher = WindowWatcher(self._enqueue, self._stop_event, max_interval=_watch_max)
        self.fvwmmfl_client = None
        self._fvwmmfl_event_thread = None
        self._cleanup_done = False
        self._setup_fvwmmfl_client()
        self._install_signal_handlers()

    def _setup_queue_wakeup(self):
        if not hasattr(self.root, "createfilehandler"):
            return
        try:
            read_fd, write_fd = os.pipe()
            os.set_blocking(read_fd, False)
            os.set_blocking(write_fd, False)
            self.root.createfilehandler(read_fd, tk.READABLE, self._on_queue_wake)
        except Exception as err:
            for fd in (locals().get("read_fd"), locals().get("write_fd")):
                if fd is None:
                    continue
                try:
                    os.close(fd)
                except OSError:
                    pass
            return
        self._queue_wake_read = read_fd
        self._queue_wake_write = write_fd
        self._queue_wake_filehandler = True

    def _close_queue_wakeup(self):
        self._cancel_after_job("_queue_drain_job")
        if self._queue_wake_filehandler and self._queue_wake_read is not None:
            try:
                self.root.deletefilehandler(self._queue_wake_read)
            except Exception:
                pass
        self._queue_wake_filehandler = False
        for fd_name in ("_queue_wake_read", "_queue_wake_write"):
            fd = getattr(self, fd_name)
            if fd is None:
                continue
            try:
                os.close(fd)
            except OSError:
                pass
            setattr(self, fd_name, None)

    def _enqueue(self, kind, payload):
        if self._stop_event.is_set():
            return
        self.queue.put((kind, payload))
        self._wake_queue()

    def _wake_queue(self):
        if not self._queue_wake_filehandler or self._queue_wake_write is None:
            return
        try:
            os.write(self._queue_wake_write, b"x")
        except BlockingIOError:
            pass
        except OSError:
            pass

    def _on_queue_wake(self, _fd, _mask):
        self._clear_queue_wake()
        self._drain_queue()

    def _clear_queue_wake(self):
        if self._queue_wake_read is not None:
            while True:
                try:
                    chunk = os.read(self._queue_wake_read, QUEUE_WAKE_READ_BYTES)
                except BlockingIOError:
                    break
                except OSError:
                    break
                if not chunk:
                    break
                if len(chunk) < QUEUE_WAKE_READ_BYTES:
                    break

    def _start_queue_drain(self):
        if self._queue_wake_filehandler:
            if not self.queue.empty():
                self._wake_queue()
            return
        self._schedule_queue_drain(QUEUE_DRAIN_IDLE_MS)

    def _schedule_queue_drain(self, delay_ms):
        if self._queue_drain_job is not None or self._stop_event.is_set():
            return
        delay_ms = max(QUEUE_DRAIN_ACTIVE_MS, int(delay_ms))
        self._queue_drain_job = self.root.after(delay_ms, self._drain_queue_from_timer)

    def _drain_queue_from_timer(self):
        self._queue_drain_job = None
        self._drain_queue()

    def _setup_fvwmmfl_client(self):
        if FvwmMFLClient is None:
            return
        client = FvwmMFLClient(logger=None)
        if not client.configured():
            return
        if not client.can_connect():
            return
        self.fvwmmfl_client = client

    def _install_signal_handlers(self):
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            try:
                signal.signal(sig, self._signal_exit)
            except Exception:
                pass

    def _signal_exit(self, *_args):
        self._cleanup()
        try:
            self.root.destroy()
        except Exception:
            pass
        sys.exit(0)

    def start(self):
        self._setup_socket()
        self._start_queue_drain()
        self._start_fvwmmfl_integration()
        self._watcher.start()
        self._schedule_tabbed_window_sweep()
        if self.auto_swallow_on_startup:
            self._schedule_startup_scan(500)
        if self._autoswallow_rules_configured():
            self._schedule_fallback_scan()
        self.root.mainloop()

    def _start_fvwmmfl_integration(self):
        if self.fvwmmfl_client is None:
            return
        if not self._autoswallow_rules_configured():
            return
        self._fvwmmfl_started_at = time.monotonic()
        self._fvwmmfl_event_thread = self.fvwmmfl_client.start_event_listener(
            FVWMMFL_AUTOSWALLOW_EVENTS,
            self._queue_fvwmmfl_event,
            stop_event=self._stop_event,
        )

    def _queue_fvwmmfl_event(self, packet):
        if extract_event_window_id is not None:
            event_name, win_id = extract_event_window_id(packet)
            if event_name and win_id is not None:
                key = (event_name, win_id)
                now = time.monotonic()
                last = self._last_queued_fvwmmfl_events.get(key)
                self._last_queued_fvwmmfl_events[key] = now
                if last is not None and now - last < FVWMMFL_QUEUE_DEBOUNCE_SECONDS:
                    return
                self._enqueue("fvwmmfl_event", (event_name, win_id, packet))
                return
        self._enqueue("fvwmmfl_event", packet)

    def _setup_socket(self):
        # The client commands are tiny one-line messages over a per-DISPLAY
        # Unix socket. A live socket means another server already owns this
        # FVWM session.
        os.makedirs(os.path.dirname(SOCKET_PATH), exist_ok=True)
        if os.path.exists(SOCKET_PATH):
            try:
                test = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                test.connect(SOCKET_PATH)
                test.close()
                sys.exit(0)
            except Exception:
                try:
                    os.unlink(SOCKET_PATH)
                except Exception:
                    pass

        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.bind(SOCKET_PATH)
        self.sock.listen(32)

        with open(PID_PATH, "w", encoding="utf-8") as handle:
            handle.write(str(os.getpid()))

        atexit.register(self._cleanup)
        threading.Thread(target=self._accept_loop, daemon=True).start()

    def _cancel_after_job(self, attr):
        job = getattr(self, attr, None)
        if job is not None:
            try:
                self.root.after_cancel(job)
            except Exception:
                pass
            setattr(self, attr, None)

    def _do_destroy_tabber(self, tabber_id, cmd_name):
        tabber = self.tabbers.pop(tabber_id, None)
        if tabber:
            tabber.on_destroy = None
            tabber.destroy()
            if self.active_tabber_id == tabber_id:
                self.active_tabber_id = None

    def _cleanup(self):
        if self._cleanup_done:
            return
        self._cleanup_done = True
        # Prevent a second SIGTERM (from session manager during logout) from
        # raising SystemExit inside this method and aborting window release.
        for _sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            try:
                signal.signal(_sig, signal.SIG_IGN)
            except Exception:
                pass
        # Shutdown releases windows back to root and closes in-process
        # resources. Runtime files are left for the next startup to reuse or
        # replace.
        self._stop_event.set()
        self._close_queue_wakeup()
        for job in list(self._pending_autoswallow.values()):
            try:
                self.root.after_cancel(job)
            except Exception:
                pass
        self._pending_autoswallow.clear()
        self._cancel_after_job("_fvwmmfl_probe_job")
        self._fvwmmfl_pending_probes.clear()
        self._fvwmmfl_in_progress.clear()
        self._fvwmmfl_nonclient_seen.clear()
        self._fvwmmfl_failed_probe_seen.clear()
        self._client_list_cache = None
        self._client_list_cache_details = None
        self._client_list_cache_at = 0.0
        for _attr in ("_startup_scan_job", "_first_tabber_scan_job", "_fallback_scan_job", "_tabbed_window_sweep_job"):
            self._cancel_after_job(_attr)
        self._autoswallow_seen.clear()
        self._autoswallow_suppressed.clear()
        for tabber in list(self.tabbers.values()):
            try:
                tabber.on_destroy = None
                tabber.release_all()
            except Exception:
                pass
        self.tabbers.clear()
        try:
            if self.sock:
                self.sock.close()
        except Exception:
            pass

    def _accept_loop(self):
        while not self._stop_event.is_set():
            try:
                conn, _ = self.sock.accept()
            except Exception:
                break
            threading.Thread(target=self._client_loop, args=(conn,), daemon=True).start()

    def _client_loop(self, conn):
        with conn:
            data = b""
            while True:
                try:
                    chunk = conn.recv(4096)
                except Exception:
                    break
                if not chunk:
                    break
                data += chunk
                while b"\n" in data:
                    line, data = data.split(b"\n", 1)
                    text = line.decode("utf-8", errors="ignore").strip()
                    if text:
                        self._enqueue("command", text)

    def _drain_queue(self):
        # Tk must own UI and reparenting work, so background threads only push
        # queue messages and this method executes them in the main loop.
        if self._draining_queue:
            self._schedule_queue_drain(QUEUE_DRAIN_ACTIVE_MS)
            return
        self._draining_queue = True
        handled = 0
        started = time.monotonic()
        try:
            while handled < QUEUE_DRAIN_LIMIT and time.monotonic() - started < QUEUE_DRAIN_BUDGET_SECONDS:
                try:
                    kind, payload = self.queue.get_nowait()
                except queue.Empty:
                    break
                handled += 1

                if kind == "command":
                    self._handle_line(payload)
                elif kind == "internal_command":
                    command, args, source = payload
                    self._execute_command(command, args, source=source)
                elif kind == "create_tabber":
                    self._create_tabber(geometry=payload)
                elif kind == "interactive_add":
                    tabber_id, win_id, title = payload
                    self._route_window_to_tabber(tabber_id, win_id, title)
                elif kind == "watch_windows":
                    current, new_windows, removed_windows, details, snapshot_at = self._unpack_watch_payload(payload)
                    self._handle_window_snapshot(
                        current,
                        new_windows,
                        removed_windows,
                        source="watcher",
                        client_list_details=details,
                        client_list_snapshot_at=snapshot_at,
                    )
                elif kind == "fvwmmfl_event":
                    self._handle_fvwmmfl_event(payload)
        finally:
            self._draining_queue = False

        remaining = self.queue.qsize()
        if self._stop_event.is_set():
            return
        if remaining:
            self._schedule_queue_drain(QUEUE_DRAIN_ACTIVE_MS)
        elif not self._queue_wake_filehandler:
            self._schedule_queue_drain(QUEUE_DRAIN_IDLE_MS)

    def _unpack_watch_payload(self, payload):
        if len(payload) == 5:
            return payload
        current, new_windows, removed_windows = payload
        return current, new_windows, removed_windows, None, None

    def _handle_fvwmmfl_event(self, packet):
        if isinstance(packet, tuple) and len(packet) == 3:
            event_name, win_id, _raw_packet = packet
        else:
            if extract_event_window_id is None:
                return
            event_name, win_id = extract_event_window_id(packet)
        if not event_name:
            return
        if win_id is None:
            return

        source = f"fvwmmfl:{event_name}"
        if event_name == "destroy_window":
            self._handle_fvwmmfl_destroy_event(win_id, source)
            return

        if event_name not in {"new_window", "map"}:
            return
        if self._ignore_fvwmmfl_client_event(event_name, win_id, source):
            return
        if self._is_fvwmmfl_nonclient_cached(win_id):
            return
        self._queue_fvwmmfl_probe(event_name, win_id, source)

    def _handle_fvwmmfl_destroy_event(self, win_id, source):
        self._known_windows.discard(win_id)
        self._cancel_pending_fvwmmfl_probe(win_id)
        self._cancel_pending_autoswallow(win_id)
        self._autoswallow_seen.pop(win_id, None)
        self._fvwmmfl_nonclient_seen.pop(win_id, None)
        self._fvwmmfl_failed_probe_seen.pop(win_id, None)
        self._clear_autoswallow_suppression(win_id)

    def _queue_fvwmmfl_probe(self, event_name, win_id, source, retries_left=AUTOSWALLOW_RETRIES):
        self._queue_autoswallow_probe(event_name, win_id, source, retries_left=retries_left)

    def _queue_autoswallow_probe(self, event_name, win_id, source, retries_left=AUTOSWALLOW_RETRIES, client_list_snapshot_at=None):
        if not self._autoswallow_rules_configured():
            return
        is_fvwmmfl_source = self._is_fvwmmfl_autoswallow_source(source)
        if win_id in self._pending_autoswallow:
            return
        if is_fvwmmfl_source and self._is_fvwmmfl_failed_probe_cached(win_id):
            return
        if is_fvwmmfl_source and self._is_fvwmmfl_nonclient_cached(win_id):
            return
        if win_id in self._fvwmmfl_in_progress:
            return

        item = self._fvwmmfl_pending_probes.get(win_id)
        if item is None:
            self._fvwmmfl_pending_probes[win_id] = {
                "events": {event_name},
                "source": source,
                "queued_at": time.monotonic(),
                "retries_left": retries_left,
                "client_list_snapshot_at": client_list_snapshot_at,
            }
        else:
            item["events"].add(event_name)
            item["source"] = self._merge_probe_source(item, source)
            item["retries_left"] = min(item.get("retries_left", AUTOSWALLOW_RETRIES), retries_left)
            if client_list_snapshot_at is not None:
                previous_snapshot_at = item.get("client_list_snapshot_at")
                if previous_snapshot_at is None or client_list_snapshot_at > previous_snapshot_at:
                    item["client_list_snapshot_at"] = client_list_snapshot_at
        self._schedule_fvwmmfl_probe_drain()

    def _schedule_fvwmmfl_probe_drain(self, delay_ms=None):
        if self._fvwmmfl_probe_job is not None or self._stop_event.is_set():
            return
        if delay_ms is None:
            delay_ms = FVWMMFL_PROBE_DRAIN_MS
            startup_remaining = FVWMMFL_STARTUP_GRACE_SECONDS - (time.monotonic() - self._fvwmmfl_started_at)
            if startup_remaining > 0:
                delay_ms = max(delay_ms, int(startup_remaining * 1000))
        delay_ms = max(FVWMMFL_PROBE_DRAIN_MS, int(delay_ms))
        self._fvwmmfl_probe_job = self.root.after(delay_ms, self._drain_fvwmmfl_probes)

    def _drain_fvwmmfl_probes(self):
        self._fvwmmfl_probe_job = None
        if self._stop_event.is_set() or not self._autoswallow_rules_configured():
            self._fvwmmfl_pending_probes.clear()
            return
        if not self._fvwmmfl_pending_probes:
            return

        processed = 0
        while self._fvwmmfl_pending_probes and processed < FVWMMFL_PROBES_PER_TICK:
            win_id, item = self._peek_next_fvwmmfl_probe()
            source = self._fvwmmfl_probe_source(item)
            if self._is_fvwmmfl_autoswallow_source(source) and self._is_fvwmmfl_failed_probe_cached(win_id):
                self._pop_next_fvwmmfl_probe()
                processed += 1
                continue
            if win_id in self._pending_autoswallow:
                self._pop_next_fvwmmfl_probe()
                processed += 1
                continue

            min_snapshot_at = item.get("client_list_snapshot_at") or item.get("queued_at", 0.0)
            current, details, _snapshot_at = self._get_cached_client_window_snapshot(min_refreshed_at=min_snapshot_at)
            if not self._client_window_snapshot_available(details):
                self._schedule_fvwmmfl_probe_drain(int(FVWMMFL_FAILED_PROBE_CACHE_TTL * 1000))
                return
            removed_windows = self._known_windows - current
            self._known_windows = current
            self._forget_removed_client_windows(removed_windows, check_exists=False)

            win_id, item = self._pop_next_fvwmmfl_probe()
            processed += 1
            source = self._fvwmmfl_probe_source(item)

            if win_id not in current:
                if self._is_fvwmmfl_autoswallow_source(source):
                    self._mark_fvwmmfl_nonclient(win_id)
                continue

            self._fvwmmfl_nonclient_seen.pop(win_id, None)
            self._last_window_detection = time.monotonic()
            self._fvwmmfl_in_progress.add(win_id)
            try:
                self._handle_new_window(
                    win_id,
                    retries_left=item.get("retries_left", AUTOSWALLOW_RETRIES),
                    source=source,
                )
            finally:
                self._fvwmmfl_in_progress.discard(win_id)

        if self._fvwmmfl_pending_probes:
            self._schedule_fvwmmfl_probe_drain(FVWMMFL_PROBE_DRAIN_MS)

    def _peek_next_fvwmmfl_probe(self):
        win_id = self._next_fvwmmfl_probe_id()
        return win_id, self._fvwmmfl_pending_probes[win_id]

    def _pop_next_fvwmmfl_probe(self):
        win_id = self._next_fvwmmfl_probe_id()
        return win_id, self._fvwmmfl_pending_probes.pop(win_id)

    def _next_fvwmmfl_probe_id(self):
        return min(
            self._fvwmmfl_pending_probes,
            key=lambda wid: self._fvwmmfl_pending_probes[wid].get("queued_at", 0),
        )

    def _merge_probe_source(self, item, source):
        current_source = item.get("source")
        if self._is_fvwmmfl_autoswallow_source(source):
            return source
        if self._is_fvwmmfl_autoswallow_source(current_source):
            return current_source
        return current_source or source

    def _fvwmmfl_probe_source(self, item):
        events = item.get("events") or set()
        if "new_window" in events:
            return "fvwmmfl:new_window"
        if "map" in events:
            return "fvwmmfl:map"
        return item.get("source", "fvwmmfl")

    def _cancel_pending_fvwmmfl_probe(self, win_id):
        self._fvwmmfl_pending_probes.pop(win_id, None)

    def _ignore_fvwmmfl_client_event(self, event_name, win_id, source):
        key = (event_name, win_id)
        now = time.monotonic()
        last = self._last_fvwmmfl_events.get(key)
        self._last_fvwmmfl_events[key] = now
        if last is not None and now - last < FVWMMFL_EVENT_DEBOUNCE_SECONDS:
            return True

        if event_name in {"new_window", "map"}:
            if win_id in self._fvwmmfl_pending_probes:
                return True
            if win_id in self._fvwmmfl_in_progress:
                return True
            if win_id in self._pending_autoswallow:
                return True
            if self._is_fvwmmfl_failed_probe_cached(win_id):
                return True

        # FvwmMFL can report map activity while FVWM is moving/resizing a normal
        # already-known client. Do not let those map storms schedule fresh
        # xprop/xwininfo/xdotool probes from the Tk thread.
        if event_name == "map" and win_id in self._known_windows:
            return True

        if event_name == "new_window" and win_id in self._known_windows:
            if self._is_autoswallow_seen(win_id):
                return True
            if win_id in self._pending_autoswallow:
                return True
            if self._is_internal_window(win_id):
                return True
        return False

    def _is_fvwmmfl_nonclient_cached(self, win_id):
        seen_at = self._fvwmmfl_nonclient_seen.get(win_id)
        if seen_at is None:
            return False
        if time.monotonic() - seen_at > FVWMMFL_NONCLIENT_CACHE_TTL:
            self._fvwmmfl_nonclient_seen.pop(win_id, None)
            return False
        return True

    def _mark_fvwmmfl_nonclient(self, win_id):
        self._fvwmmfl_nonclient_seen[win_id] = time.monotonic()

    def _is_fvwmmfl_failed_probe_cached(self, win_id):
        seen_at = self._fvwmmfl_failed_probe_seen.get(win_id)
        if seen_at is None:
            return False
        if time.monotonic() - seen_at > FVWMMFL_FAILED_PROBE_CACHE_TTL:
            self._fvwmmfl_failed_probe_seen.pop(win_id, None)
            return False
        return True

    def _mark_fvwmmfl_failed_probe(self, win_id):
        self._fvwmmfl_failed_probe_seen[win_id] = time.monotonic()

    def _is_fvwmmfl_autoswallow_source(self, source):
        return str(source or "").startswith("fvwmmfl:")

    def _is_throttled_autoswallow_source(self, source):
        return self._is_fvwmmfl_autoswallow_source(source) or source in {
            "watcher",
            "startup_scan",
            "first_tabber_scan",
            "fallback_scan",
        }

    def _client_window_snapshot_available(self, details):
        return _client_snapshot_available(details)

    def _cache_client_window_snapshot(self, current, details, snapshot_at=None):
        self._client_list_cache = set(current)
        self._client_list_cache_details = details
        self._client_list_cache_at = snapshot_at or time.monotonic()
        return self._client_list_cache_at

    def _get_cached_client_window_snapshot(self, min_refreshed_at=0.0, force=False):
        started = time.monotonic()
        now = started
        if (
            not force
            and self._client_list_cache is not None
            and self._client_list_cache_details is not None
            and now - self._client_list_cache_at <= CLIENT_LIST_CACHE_SECONDS
            and self._client_list_cache_at >= min_refreshed_at
        ):
            return set(self._client_list_cache), self._client_list_cache_details, self._client_list_cache_at
        if (
            force
            and self._client_list_cache is not None
            and self._client_list_cache_details is not None
            and now - self._client_list_cache_at <= CLIENT_LIST_FORCE_MIN_INTERVAL_SECONDS
            and self._client_list_cache_at >= min_refreshed_at
        ):
            return set(self._client_list_cache), self._client_list_cache_details, self._client_list_cache_at

        current, details = _get_client_window_snapshot()
        snapshot_at = self._cache_client_window_snapshot(current, details)
        return current, details, snapshot_at

    def _handle_line(self, line):
        try:
            parts = shlex.split(line)
        except Exception as err:
            parts = line.split()
        if not parts:
            return

        self._execute_command(parts[0], parts[1:], source="socket")

    def _canonical_command(self, command):
        # Keep old FvwmConsole/client command spellings working. ConfigFvwmTabs
        # still exposes both default-tabber and explicit-ID commands.
        aliases = {
            "createnewtabber": "new_tabber",
            "newtabber": "new_tabber",
            "add": "add",
            "tabize": "tabize",
            "tabizeactive": "tabize_active",
            "nexttab": "next_tab",
            "nexttabactive": "next_tab_active",
            "prevtab": "prev_tab",
            "prevtabactive": "prev_tab_active",
            "destroytabber": "destroy_tabber",
            "destroyactivetabber": "destroy_active_tabber",
            "ping": "ping",
            "quit": "quit",
        }
        return aliases.get(command.strip().lower())

    def _execute_command(self, command, args=None, source="internal"):
        args = list(args or [])
        action = self._canonical_command(command)
        if action is None:
            return

        if action == "ping":
            return

        if action == "new_tabber":
            geometry = self._parse_new_tabber_args(args)
            self._request_new_tabber(geometry)
            return

        if action == "add":
            if len(args) < 2:
                return
            tabber_id = _normalize_tabber_id(args[0], default=1)
            if tabber_id is None:
                return
            try:
                win_id = int(args[1], 0)
            except ValueError:
                return
            title = " ".join(args[2:]) if len(args) > 2 else _get_window_identity(win_id)["name"]
            self._route_window_to_tabber(tabber_id, win_id, title)
            return

        if action == "tabize":
            tabber_id = _normalize_tabber_id(args[0], default=1) if args else 1
            self._request_add_loop(tabber_id)
            return

        if action == "tabize_active":
            tabber_id = self._get_active_tabber_id()
            self._request_add_loop(tabber_id)
            return

        if action == "next_tab":
            tabber_id = _normalize_tabber_id(args[0], default=1) if args else 1
            if tabber_id in self.tabbers:
                self.tabbers[tabber_id].next_tab()
            return

        if action == "next_tab_active":
            tabber_id = self._get_active_tabber_id()
            if tabber_id in self.tabbers:
                self.tabbers[tabber_id].next_tab()
            return

        if action == "prev_tab":
            tabber_id = _normalize_tabber_id(args[0], default=1) if args else 1
            if tabber_id in self.tabbers:
                self.tabbers[tabber_id].prev_tab()
            return

        if action == "prev_tab_active":
            tabber_id = self._get_active_tabber_id()
            if tabber_id in self.tabbers:
                self.tabbers[tabber_id].prev_tab()
            return

        if action == "destroy_tabber":
            tabber_id = _normalize_tabber_id(args[0], default=1) if args else 1
            self._do_destroy_tabber(tabber_id, "destroyTabber")
            return

        if action == "destroy_active_tabber":
            tabber_id = self._get_active_tabber_id()
            self._do_destroy_tabber(tabber_id, "destroyActiveTabber")
            return

        if action == "quit":
            self._cleanup()
            try:
                self.root.destroy()
            except Exception:
                pass
            sys.exit(0)

    def _parse_new_tabber_args(self, args):
        geometry = None
        idx = 0
        while idx < len(args):
            arg = args[idx]
            if arg.startswith("--geometry="):
                geometry = arg.split("=", 1)[1]
                idx += 1
                continue
            if arg in ("--geometry", "-g") and idx + 1 < len(args):
                geometry = args[idx + 1]
                idx += 2
                continue
            if geometry is None and (
                arg.startswith(("+", "-")) or
                ("x" in arg and any(ch in arg for ch in "+-"))
            ):
                geometry = arg
                idx += 1
                continue
            idx += 1
        return geometry

    def _next_tabber_id(self):
        if self._next_tabber_counter < 1:
            self._next_tabber_counter = 1
        while self._next_tabber_counter in self.tabbers:
            self._next_tabber_counter += 1
        tabber_id = self._next_tabber_counter
        self._next_tabber_counter += 1
        return tabber_id

    def _create_tabber(self, tabber_id=None, geometry=None):
        # New tabbers become active immediately; focus/dropdown events can move
        # active_tabber_id later.
        had_tabbers = bool(self.tabbers)
        if tabber_id is None:
            tabber_id = self._next_tabber_id()
        else:
            tabber_id = _normalize_tabber_id(tabber_id)
        if tabber_id is None:
            return None

        if tabber_id in self.tabbers:
            existing = self.tabbers[tabber_id]
            if geometry:
                existing.top.geometry(geometry)
            existing.activate()
            return existing

        tabber = Tabber(
            self.root,
            tabber_id,
            theme_name=self.default_theme,
            geometry=geometry,
            on_destroy=self._forget_tabber,
            on_active=self._set_active_tabber,
            on_window_released=self._suppress_autoswallow,
            request_new_tabber=self._request_new_tabber,
            request_add_loop=self._request_add_loop,
            request_command=self._request_command,
        )
        self.tabbers[tabber_id] = tabber
        if self._next_tabber_counter <= tabber_id:
            self._next_tabber_counter = tabber_id + 1
        tabber.activate()
        tabber.top.update_idletasks()
        self.root.after(100, tabber.activate)
        self._set_active_tabber(tabber_id, "created")
        if self.auto_swallow_on_startup and not self._startup_scan_done:
            self._schedule_startup_scan(250)
        if not had_tabbers and self._autoswallow_rules_configured():
            self._schedule_first_tabber_scan(500)
        return tabber

    def _request_new_tabber(self, geometry=None):
        self._enqueue("create_tabber", geometry)

    def _request_command(self, command, args=None, source="internal"):
        self._enqueue("internal_command", (command, list(args or []), source))

    def _request_add_loop(self, tabber_id):
        if not self._selection_lock.acquire(blocking=False):
            return
        threading.Thread(target=self._interactive_add_loop_guarded, args=(tabber_id,), daemon=True).start()

    def _set_active_tabber(self, tabber_id, source="unknown"):
        normalized_id = _normalize_tabber_id(tabber_id)
        if normalized_id is None:
            return
        if self.active_tabber_id != normalized_id:
            self.active_tabber_id = normalized_id

    def _get_active_tabber_id(self):
        if self.active_tabber_id in self.tabbers:
            return self.active_tabber_id
        if self.active_tabber_id is not None:
            self.active_tabber_id = None
        return 1

    def _interactive_add_loop(self, tabber_id):
        root_id = _get_root_window_id()
        while not self._stop_event.is_set():
            win_id = _select_window()
            if win_id is None or win_id == root_id:
                return
            title = _get_window_identity(win_id)["name"]
            self._enqueue("interactive_add", (tabber_id, win_id, title))

    def _interactive_add_loop_guarded(self, tabber_id):
        try:
            self._interactive_add_loop(tabber_id)
        finally:
            try:
                self._selection_lock.release()
            except RuntimeError:
                pass

    def _get_tabber(self, tabber_id, geometry=None, source="route", create_missing=True):
        normalized_id = _normalize_tabber_id(tabber_id)
        if normalized_id is None:
            return None
        if normalized_id not in self.tabbers:
            if not create_missing:
                return None
            tabber = self._create_tabber(normalized_id, geometry)
            return tabber
        tabber = self.tabbers[normalized_id]
        if geometry:
            tabber.top.geometry(geometry)
        return tabber

    def _tabber_exists(self, tabber_id):
        normalized_id = _normalize_tabber_id(tabber_id)
        return normalized_id is not None and normalized_id in self.tabbers

    def _forget_tabber(self, tabber_id):
        normalized_id = _normalize_tabber_id(tabber_id)
        if normalized_id is not None:
            self.tabbers.pop(normalized_id, None)
            if self.active_tabber_id == normalized_id:
                self.active_tabber_id = None

    def _route_window_to_tabber(self, tabber_id, win_id, title=None, source="manual", create_missing=True):
        # Manual add and autoSwallow both converge here so every tab follows the
        # same storage, release, kill, and destroy path.
        #
        # When this call will auto-create the target tabber, seed it with the
        # target window's current geometry. A geometry-less tabber is placed by
        # Fvwm at a default position and visibly jumps before we can swallow the
        # window. Only read geometry when creating a brand-new tabber so existing
        # tabbers are never moved out from under the user; fall back to default
        # placement if the geometry cannot be read.
        create_geometry = None
        if create_missing and not self._tabber_exists(tabber_id):
            create_geometry = _get_window_geometry_string(win_id)
        tabber = self._get_tabber(
            tabber_id, geometry=create_geometry, source=source, create_missing=create_missing
        )
        if tabber is None:
            return False
        self._release_window_from_other_tabber(win_id, skip_id=tabber.tabber_id)
        result = tabber.add_window(win_id, title or _get_window_identity(win_id)["name"])
        return result

    def _release_window_from_other_tabber(self, win_id, skip_id=None):
        for tabber_id, tabber in list(self.tabbers.items()):
            if tabber_id == skip_id:
                continue
            if tabber.has_window(win_id):
                tabber.release_tab(win_id)
                return

    def _handle_window_snapshot(
        self,
        current,
        new_windows,
        removed_windows,
        source="watcher",
        client_list_details=None,
        client_list_snapshot_at=None,
    ):
        # Removed EWMH client-list entries can be ordinary reparent side effects.
        # Do not verify them synchronously; released-window suppression has its
        # own TTL and FvwmMFL destroy events also clear it when available.
        if client_list_details is not None and client_list_snapshot_at is not None:
            self._cache_client_window_snapshot(current, client_list_details, snapshot_at=client_list_snapshot_at)
        self._known_windows = current
        if new_windows:
            self._last_window_detection = time.monotonic()
        self._forget_removed_client_windows(removed_windows, check_exists=False)
        queued = 0
        skipped = 0
        for win_id in sorted(new_windows):
            if not self._autoswallow_rules_configured():
                skipped += 1
                continue
            if self._is_internal_window(win_id):
                self._mark_autoswallow_seen(win_id)
                skipped += 1
                continue
            if self._is_autoswallow_seen(win_id):
                skipped += 1
                continue
            if self._is_autoswallow_suppressed(win_id):
                skipped += 1
                continue
            if win_id in self._pending_autoswallow or win_id in self._fvwmmfl_pending_probes:
                skipped += 1
                continue
            self._queue_autoswallow_probe(
                source,
                win_id,
                source,
                client_list_snapshot_at=client_list_snapshot_at,
            )
            queued += 1

    def _forget_removed_client_windows(self, removed_windows, check_exists=True):
        checked = 0
        cleared = 0
        existing_windows = None
        if check_exists and removed_windows:
            existing_windows = _list_existing_x_windows()
        for win_id in removed_windows:
            if not check_exists:
                continue
            checked += 1
            if existing_windows is None or win_id in existing_windows:
                continue
            self._cancel_pending_fvwmmfl_probe(win_id)
            self._cancel_pending_autoswallow(win_id)
            self._autoswallow_seen.pop(win_id, None)
            self._fvwmmfl_nonclient_seen.pop(win_id, None)
            self._fvwmmfl_failed_probe_seen.pop(win_id, None)
            self._clear_autoswallow_suppression(win_id)
            cleared += 1

    def _cancel_pending_autoswallow(self, win_id):
        job = self._pending_autoswallow.pop(win_id, None)
        if job is None:
            return
        try:
            self.root.after_cancel(job)
        except Exception:
            pass

    def _autoswallow_rules_configured(self):
        return bool(self.auto_swallow_class or self.auto_swallow_resource or self.auto_swallow_name)

    def _mark_autoswallow_seen(self, win_id):
        self._autoswallow_seen[win_id] = time.monotonic()

    def _is_autoswallow_seen(self, win_id):
        seen_at = self._autoswallow_seen.get(win_id)
        if seen_at is None:
            return False
        if time.monotonic() - seen_at > AUTOSWALLOW_CACHE_TTL:
            self._autoswallow_seen.pop(win_id, None)
            return False
        return True

    def _suppress_autoswallow(self, win_id, reason="manual-release"):
        # A released matching window is still a valid client window, so suppress
        # it briefly to prevent "release then immediately swallow again".
        self._autoswallow_suppressed[win_id] = (time.monotonic(), reason)
        self._cancel_pending_autoswallow(win_id)

    def _is_autoswallow_suppressed(self, win_id):
        item = self._autoswallow_suppressed.get(win_id)
        if item is None:
            return False
        suppressed_at, _reason = item
        if time.monotonic() - suppressed_at > AUTOSWALLOW_SUPPRESS_TTL:
            self._autoswallow_suppressed.pop(win_id, None)
            return False
        return True

    def _clear_autoswallow_suppression(self, win_id):
        self._autoswallow_suppressed.pop(win_id, None)

    def _identity_missing_for_rules(self, identity):
        if self.auto_swallow_class and not identity.get("class"):
            return True
        if self.auto_swallow_resource and not identity.get("resource"):
            return True
        if self.auto_swallow_name and not identity.get("name"):
            return True
        return False

    def _format_rule_group(self, rules):
        if not rules:
            return "[]"
        return "[" + ", ".join("%r->%s" % (pattern, tabber_id) for pattern, tabber_id in rules) + "]"

    def _format_autoswallow_rules(self):
        return (
            "class=%s resource=%s name=%s"
            % (
                self._format_rule_group(self.auto_swallow_class),
                self._format_rule_group(self.auto_swallow_resource),
                self._format_rule_group(self.auto_swallow_name),
            )
        )

    def _format_tabber_summary(self):
        if not self.tabbers:
            return "[]"
        return "[" + ", ".join(
            "id=%s tabs=%s" % (tabber_id, len(tabber.tabs))
            for tabber_id, tabber in sorted(self.tabbers.items())
        ) + "]"

    def _format_window_list(self, windows):
        if not windows:
            return "[]"
        return "[" + ", ".join("0x%x" % win_id for win_id in sorted(windows)) + "]"

    def _has_tabbed_windows(self):
        return any(tabber.tabs for tabber in self.tabbers.values())

    def _schedule_tabbed_window_sweep(self):
        if self._tabbed_window_sweep_job is not None or self._stop_event.is_set():
            return
        self._tabbed_window_sweep_job = self.root.after(TABBED_WINDOW_SWEEP_MS, self._sweep_tabbed_windows)

    def _sweep_tabbed_windows(self):
        self._tabbed_window_sweep_job = None
        try:
            if self._stop_event.is_set():
                return
            if not self._has_tabbed_windows():
                return
            existing_windows = _list_existing_x_windows()
            if existing_windows is None:
                return
            removed = 0
            tabs = 0
            for tabber in list(self.tabbers.values()):
                tabs += len(tabber.tabs)
                removed += tabber.remove_missing_windows(existing_windows)
        finally:
            self._schedule_tabbed_window_sweep()

    def _scan_existing_windows(self):
        # autoSwallowOnStartup is the broad startup scan. A separate first-tabber
        # safety scan exists below for the common "create tabber, then app" case.
        self._startup_scan_job = None
        if self._stop_event.is_set() or not self.auto_swallow_on_startup or self._startup_scan_done:
            return
        if not self.tabbers:
            self._startup_scan_attempts += 1
            if self._startup_scan_attempts <= 30:
                self._schedule_startup_scan(1000)
            return

        self._startup_scan_done = True
        self._process_autoswallow_scan("startup_scan")

    def _schedule_startup_scan(self, delay_ms):
        if self._startup_scan_job is not None or self._startup_scan_done:
            return
        delay_ms = max(250, int(delay_ms))
        self._startup_scan_job = self.root.after(delay_ms, self._scan_existing_windows)

    def _scan_after_first_tabber(self):
        self._first_tabber_scan_job = None
        if self._stop_event.is_set() or self._first_tabber_scan_done or not self._autoswallow_rules_configured():
            return
        self._first_tabber_scan_done = True
        if not self.tabbers:
            return
        self._process_autoswallow_scan("first_tabber_scan")

    def _schedule_first_tabber_scan(self, delay_ms):
        if self._first_tabber_scan_job is not None or self._first_tabber_scan_done:
            return
        delay_ms = max(250, int(delay_ms))
        self._first_tabber_scan_job = self.root.after(delay_ms, self._scan_after_first_tabber)

    def _fallback_scan_windows(self):
        # Polling _NET_CLIENT_LIST is intentionally simple; this periodic pass
        # catches windows missed between watcher snapshots without reprocessing
        # known clients.
        self._fallback_scan_job = None
        try:
            if self._stop_event.is_set() or not self._autoswallow_rules_configured():
                return
            idle_seconds = time.monotonic() - self._last_window_detection
            if idle_seconds < (AUTOSWALLOW_FALLBACK_SCAN_MS / 1000.0):
                return
            current, details, snapshot_at = self._get_cached_client_window_snapshot(force=True)
            if not self._client_window_snapshot_available(details):
                return
            new_windows = current - self._known_windows
            removed_windows = self._known_windows - current
            self._handle_window_snapshot(
                current,
                new_windows,
                removed_windows,
                source="fallback_scan",
                client_list_snapshot_at=snapshot_at,
            )
        finally:
            self._schedule_fallback_scan()

    def _schedule_fallback_scan(self):
        if self._fallback_scan_job is not None or self._stop_event.is_set() or not self._autoswallow_rules_configured():
            return
        self._fallback_scan_job = self.root.after(AUTOSWALLOW_FALLBACK_SCAN_MS, self._fallback_scan_windows)

    def _process_autoswallow_scan(self, source):
        current, details, snapshot_at = self._get_cached_client_window_snapshot(force=True)
        if not self._client_window_snapshot_available(details):
            return
        removed_windows = self._known_windows - current
        self._known_windows = current
        self._forget_removed_client_windows(removed_windows, check_exists=True)
        queued = 0
        skipped = 0
        for win_id in sorted(current):
            if self._is_internal_window(win_id):
                self._mark_autoswallow_seen(win_id)
                skipped += 1
                continue
            if self._is_autoswallow_seen(win_id):
                skipped += 1
                continue
            if self._is_autoswallow_suppressed(win_id):
                skipped += 1
                continue
            if win_id in self._pending_autoswallow or win_id in self._fvwmmfl_pending_probes:
                skipped += 1
                continue
            self._queue_autoswallow_probe(
                source,
                win_id,
                source,
                client_list_snapshot_at=snapshot_at,
            )
            queued += 1

    def _handle_new_window(self, win_id, retries_left=AUTOSWALLOW_RETRIES, source="watcher"):
        # Candidate filtering is ordered from cheap/local checks to xprop-heavy
        # identity work and finally to rule matching/routing.
        if not self._autoswallow_rules_configured():
            return
        if win_id not in self._known_windows:
            self._cancel_pending_autoswallow(win_id)
            return
        if self._is_autoswallow_suppressed(win_id):
            self._cancel_pending_autoswallow(win_id)
            return
        if self._is_autoswallow_seen(win_id):
            return
        if self._is_internal_window(win_id):
            self._mark_autoswallow_seen(win_id)
            self._cancel_pending_autoswallow(win_id)
            return

        identity = _get_window_identity(win_id, timeout=AUTOSWALLOW_PROBE_COMMAND_TIMEOUT)
        if _identity_is_tabber_window(identity):
            self._mark_autoswallow_seen(win_id)
            self._cancel_pending_autoswallow(win_id)
            return
        if identity.get("probe_timeout") and self._is_fvwmmfl_autoswallow_source(source):
            self._mark_fvwmmfl_failed_probe(win_id)
            self._cancel_pending_autoswallow(win_id)
            return
        skip_reason = self._autoswallow_skip_reason(identity, timeout=AUTOSWALLOW_PROBE_COMMAND_TIMEOUT)
        if skip_reason:
            self._mark_autoswallow_seen(win_id)
            self._cancel_pending_autoswallow(win_id)
            return

        target_id, rule_kind, pattern = self._match_autoswallow_target(identity)
        if target_id is not None:
            target_existed = self._tabber_exists(target_id)
            if not target_existed:
                if not self.auto_create_assigned_tabber:
                    self._mark_autoswallow_seen(win_id)
                    self._cancel_pending_autoswallow(win_id)
                    return
            routed = self._route_window_to_tabber(
                target_id,
                win_id,
                identity["name"] or str(win_id),
                source="autoSwallow",
                create_missing=self.auto_create_assigned_tabber,
            )
            if routed:
                self._mark_autoswallow_seen(win_id)
                self._cancel_pending_autoswallow(win_id)
                return

            if retries_left <= 1:
                self._mark_autoswallow_seen(win_id)
                self._cancel_pending_autoswallow(win_id)
                return
            self._schedule_autoswallow_retry(win_id, retries_left - 1, identity, source)
            return

        missing_needed_identity = self._identity_missing_for_rules(identity)
        if retries_left <= 1 or not missing_needed_identity:
            self._mark_autoswallow_seen(win_id)
            self._cancel_pending_autoswallow(win_id)
            return

        self._schedule_autoswallow_retry(win_id, retries_left - 1, identity, source)

    def _schedule_autoswallow_retry(self, win_id, retries_left, identity, source):
        self._cancel_pending_autoswallow(win_id)
        if self._is_throttled_autoswallow_source(source):
            self._pending_autoswallow[win_id] = self.root.after(
                AUTOSWALLOW_RETRY_MS,
                lambda wid=win_id, retries=retries_left, src=source: self._queue_throttled_autoswallow_retry_probe(wid, retries, src),
            )
            return
        self._pending_autoswallow[win_id] = self.root.after(
            AUTOSWALLOW_RETRY_MS,
            lambda wid=win_id, retries=retries_left, src=source: self._handle_new_window(wid, retries, src),
        )

    def _queue_throttled_autoswallow_retry_probe(self, win_id, retries_left, source):
        self._pending_autoswallow.pop(win_id, None)
        self._queue_autoswallow_probe("retry", win_id, source, retries_left=retries_left)

    def _autoswallow_skip_reason(self, identity, timeout=EXTERNAL_COMMAND_TIMEOUT):
        role = (identity.get("role") or "").lower()
        window_type = (identity.get("window_type") or "").lower()
        if identity.get("transient_for"):
            return "transient-window"
        if any(term in role for term in ("popup", "pop-up", "menu", "dialog", "tooltip")):
            return "window-role"
        if any(term in window_type for term in ("menu", "dialog", "splash", "tooltip", "dropdown", "popup")):
            return "window-type"
        if self._is_override_redirect(identity["id"], timeout=timeout):
            return "override-redirect"
        return None

    def _is_override_redirect(self, win_id, timeout=EXTERNAL_COMMAND_TIMEOUT):
        try:
            out = _run_capture(["xwininfo", "-id", str(win_id)], timeout=timeout)
        except Exception:
            return False
        for line in out.splitlines():
            if "Override Redirect State:" in line:
                return line.rsplit(":", 1)[1].strip().lower() == "yes"
        return False

    def _is_internal_window(self, win_id):
        for tabber in self.tabbers.values():
            try:
                if tabber.top.winfo_exists() and tabber.top.winfo_id() == win_id:
                    return True
            except Exception:
                pass
            if tabber.has_window(win_id):
                return True
        return False

    def _match_autoswallow_target(self, identity):
        # Match stable WM_CLASS class first. Resource and title rules stay for
        # compatibility with older FvwmTabs configs and odd applications.
        for pattern, tabber_id in self.auto_swallow_class:
            if _matches_pattern(pattern, identity.get("class", "")):
                return tabber_id, "class", pattern
        for pattern, tabber_id in self.auto_swallow_resource:
            if _matches_pattern(pattern, identity.get("resource", "")):
                return tabber_id, "resource", pattern
        for pattern, tabber_id in self.auto_swallow_name:
            if _matches_pattern(pattern, identity.get("name", "")):
                return tabber_id, "name", pattern
        return None, None, None


def _stderr(message):
    print(f"FvwmTabs: {message}", file=sys.stderr)


def _fvwm_quote(value):
    text = str(value)
    if text and not any(ch.isspace() or ch in "\"'`\\" for ch in text):
        return text
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def _module_fds(argv):
    if len(argv) < 3:
        return None, None
    write_fd = argv[1]
    read_fd = argv[2]
    if not write_fd.isdecimal() or not read_fd.isdecimal():
        return None, None
    write_fd = int(write_fd)
    read_fd = int(read_fd)
    if write_fd < 0 or read_fd < 0:
        return None, None
    return write_fd, read_fd


def _send_module_command(write_fd, command):
    payload = command.encode("utf-8")
    # FVWM module commands use native C long fields, matching fvwm's
    # pack("l!l!a...l!") convention in the shipped Perl module helpers.
    os.write(write_fd, struct.pack("@l", 0))
    os.write(write_fd, struct.pack("@l", len(payload)))
    os.write(write_fd, payload)
    os.write(write_fd, struct.pack("@l", 1))


def _load_fvwm_functions(write_fd):
    if write_fd is None:
        _stderr("FVWM module file descriptor arguments were not present")
        return False
    if not os.path.isfile(FVWM_CONFIG_PATH):
        _stderr(f"missing {FVWM_CONFIG_PATH}")
        return False
    try:
        _send_module_command(write_fd, f"SetEnv FVWMTABS_DIR {_fvwm_quote(MODULE_DIR)}")
        _send_module_command(write_fd, f"Read {_fvwm_quote(FVWM_CONFIG_PATH)}")
        return True
    except OSError as err:
        _stderr(f"could not send FVWM startup commands through module fd {write_fd}: {err}")
        return False


def _start_server_client():
    try:
        result = subprocess.run(
            [sys.executable or "python3", TABBER_CLIENT_PATH, "start"],
            timeout=SERVER_CLIENT_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        _stderr(f"tabber_client.py start timed out after {SERVER_CLIENT_TIMEOUT:.1f}s")
        return False
    except Exception as err:
        _stderr(f"could not run tabber_client.py start: {err}")
        return False
    if result.returncode != 0:
        _stderr(f"tabber_client.py start exited with status {result.returncode}")
        return False
    return True


def _wait_for_fvwm_exit(read_fd, module_token=None):
    # FVWM closes the module read fd on shutdown. Prefer monitoring it so the
    # wrapper exits cleanly without disturbing the long-running server.
    if read_fd is None:
        while True:
            try:
                if _fvwm_module_token_changed(module_token):
                    return "restart-handoff"
                signal.pause()
            except AttributeError:
                time.sleep(3600)
            except InterruptedError:
                continue

    poller = None
    try:
        poller = select.poll()
        poller.register(read_fd, select.POLLIN | select.POLLHUP | select.POLLERR)
    except Exception:
        poller = None

    while True:
        if _fvwm_module_token_changed(module_token):
            return "restart-handoff"
        if poller is None:
            try:
                data = os.read(read_fd, 4096)
                if not data:
                    return "disconnect"
            except InterruptedError:
                continue
            except Exception:
                return "disconnect"
            time.sleep(1.0)
            continue

        try:
            events = poller.poll(1000)
        except InterruptedError:
            continue
        except Exception:
            return "disconnect"
        for _fd, event in events:
            if event & (select.POLLHUP | select.POLLERR):
                return "disconnect"
            if event & select.POLLIN:
                try:
                    data = os.read(read_fd, 4096)
                except InterruptedError:
                    continue
                except Exception:
                    return "disconnect"
                if not data:
                    return "disconnect"


def _module_main(argv):
    if not os.path.isfile(TABBER_CLIENT_PATH):
        _stderr(f"missing {TABBER_CLIENT_PATH}")
        return 1

    module_token = _write_fvwm_module_token()
    write_fd, read_fd = _module_fds(argv)
    config_loaded = _load_fvwm_functions(write_fd)
    server_started = _start_server_client()
    if not (config_loaded and server_started):
        return 1

    def _handle_exit(_signum, _frame):
        raise SystemExit(0)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, _handle_exit)
        except Exception:
            pass

    _wait_for_fvwm_exit(read_fd, module_token=module_token)
    return 0


def _server_main():
    server = FvwmTabsServer()
    server.start()


def main(argv=None):
    argv = list(argv or sys.argv)
    if len(argv) > 1 and argv[1] == "--server":
        return _server_main()
    if _module_fds(argv) != (None, None):
        return _module_main(argv)
    return _server_main()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
