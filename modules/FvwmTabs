# ---------------------------------------------------------------------------
# FvwmMFL integration (inlined).
#
# FvwmTabs talks to FVWM through the standard FvwmMFL module. The smal Unix-socket
# client and JSON-event helpers are inlined here so FvwmTabs is fully self-contained.
#
# Two things travel over the FvwmMFL socket:
#   * autoSwallow window events (new_window / map / destroy_window), and
#   * FvwmTabs commands, delivered as FVWM "echo" events. ConfigFvwmTabs runs
#     `Echo FvwmTabsCmd <command>`; FVWM broadcasts MX_ECHO; FvwmMFL re-emits it
#     as {"echo": {"message": "FvwmTabsCmd <command>"}} to subscribed clients;
#     the server strips the tag and dispatches <command>. Adding a new command
#     later is a one-line ConfigFvwmTabs entry, no server change.
# ---------------------------------------------------------------------------

# Default FvwmMFL socket (see the FvwmMFL manpage). $FVWMMFL_SOCKET /
# $FVWMMFL_SOCKET_PATH override it when set.
FVWMMFL_ENV_SOCKET_KEYS = ("FVWMMFL_SOCKET", "FVWMMFL_SOCKET_PATH")
FVWMMFL_AUTOSWALLOW_EVENTS = ("new_window", "map", "destroy_window")
# The FVWM "echo" event carries the command line; this tag distinguishes our
# echoes from any other module's use of the Echo command.
FVWMMFL_COMMAND_EVENT = "echo"
FVWMTABS_COMMAND_TAG = "FvwmTabsCmd"

def _fvwmmfl_default_socket_paths():
    # Default FvwmMFL socket locations, in priority order. fvwm3 has used two
    # layouts: the newer per-display path under /tmp/fvwmmfl/ and the flat
    # /tmp/fvwm_mfl.sock used by fvwm3 1.0.6a and older. We also honour $TMPDIR
    # for the per-display layout when it is set.
    display = os.environ.get("DISPLAY", ":0")
    paths = [
        os.path.join("/tmp", "fvwmmfl", f"fvwm_mfl_{display}.sock"),  # newer fvwm3
        os.path.join("/tmp", "fvwm_mfl.sock"),  # fvwm3 1.0.6a and older
    ]
    tmpdir = os.environ.get("TMPDIR")
    if tmpdir:
        paths.append(os.path.join(tmpdir, "fvwmmfl", f"fvwm_mfl_{display}.sock"))
    return paths

def _parse_window_id(value):
    if isinstance(value, int):
        return value if value > 0 else None
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text:
        return None
    try:
        return int(text, 0)
    except ValueError:
        return None

def _find_window_id(value):
    if isinstance(value, dict):
        for key in ("window", "window_id", "id"):
            if key in value:
                parsed = _parse_window_id(value[key])
                if parsed is not None:
                    return parsed
        for item in value.values():
            parsed = _find_window_id(item)
            if parsed is not None:
                return parsed
    elif isinstance(value, (list, tuple)):
        for item in value:
            parsed = _find_window_id(item)
            if parsed is not None:
                return parsed
    return _parse_window_id(value)

def extract_event_window_id(packet):
    """Return (event_name, window_id) from a FvwmMFL JSON packet when present."""
    if not isinstance(packet, dict) or not packet:
        return None, None
    event_name, payload = next(iter(packet.items()))
    return event_name, _find_window_id(payload)

def _find_echo_message(value):
    if isinstance(value, str):
        return value
    if isinstance(value, dict):
        if isinstance(value.get("message"), str):
            return value["message"]
        for item in value.values():
            found = _find_echo_message(item)
            if found is not None:
                return found
    elif isinstance(value, (list, tuple)):
        for item in value:
            found = _find_echo_message(item)
            if found is not None:
                return found
    return None

def extract_echo_command(packet, tag=FVWMTABS_COMMAND_TAG):
    """Return the FvwmTabs command line carried by an 'echo' event, or None.
    The echo message is 'FvwmTabsCmd <command...>'. Untagged echoes (from other
    modules or users) are ignored.
    """
    if not isinstance(packet, dict) or not packet:
        return None
    event_name, payload = next(iter(packet.items()))
    if event_name != FVWMMFL_COMMAND_EVENT:
        return None
    message = _find_echo_message(payload)
    if not isinstance(message, str):
        return None
    parts = message.strip().split(None, 1)
    if not parts or parts[0] != tag:
        return None
    return parts[1].strip() if len(parts) > 1 else ""

class FvwmMFLClient:
    """Minimal FvwmMFL Unix-socket client: subscribe to events, read JSON.
    The server never sends FVWM commands through this socket; it only subscribes
    (``set <event>``) and reads JSON event packets. Command delivery to FvwmTabs
    happens entirely via the echo round-trip described above.
    """

    def __init__(self, socket_path=None, logger=None, connect_timeout=1.0):
        self.socket_path = socket_path
        self.connect_timeout = connect_timeout
        self.active_socket_path = None
        self._decoder = json.JSONDecoder()

    def candidate_paths(self):
        # An explicit socket_path passed to the constructor is an absolute
        # override. Otherwise try, in order: $FVWMMFL_SOCKET,
        # $FVWMMFL_SOCKET_PATH, then every default location. The first path
        # that actually exists as a socket (see locate_socket) wins.
        if self.socket_path:
            return [self.socket_path]
        paths = []
        for key in FVWMMFL_ENV_SOCKET_KEYS:
            value = os.environ.get(key)
            if value:
                paths.append(value)
        paths.extend(_fvwmmfl_default_socket_paths())

        unique = []
        seen = set()
        for path in paths:
            if path and path not in seen:
                unique.append(path)
                seen.add(path)
        return unique

    def configured(self):
        return bool(self.candidate_paths())

    def locate_socket(self):
        for path in self.candidate_paths():
            try:
                mode = os.stat(path).st_mode
            except FileNotFoundError:
                continue
            except OSError:
                continue
            if stat.S_ISSOCK(mode):
                self.active_socket_path = path
                return path
        return None

    def available(self):
        return self.locate_socket() is not None

    def _connect(self):
        path = self.locate_socket()
        if not path:
            return None
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.connect_timeout)
        try:
            sock.connect(path)
        except OSError:
            sock.close()
            return None
        return sock

    def can_connect(self):
        sock = self._connect()
        if sock is None:
            return False
        try:
            return True
        finally:
            try:
                sock.close()
            except OSError:
                pass

    def start_event_listener(self, events, callback, stop_event=None, reconnect_delay=2.0):
        events = tuple(events or FVWMMFL_AUTOSWALLOW_EVENTS)
        stop_event = stop_event or threading.Event()
        thread = threading.Thread(
            target=self._event_loop,
            args=(events, callback, stop_event, reconnect_delay),
            daemon=True,
        )
        thread.start()
        return thread

    def _event_loop(self, events, callback, stop_event, reconnect_delay):
        while not stop_event.is_set():
            sock = self._connect()
            if sock is None:
                stop_event.wait(reconnect_delay)
                continue
            try:
                sock.settimeout(1.0)
                for event in events:
                    sock.sendall((f"set {event}\n").encode("utf-8"))
                self._read_events(sock, callback, stop_event)
            except OSError:
                pass
            finally:
                try:
                    sock.close()
                except OSError:
                    pass
            stop_event.wait(reconnect_delay)

    def _read_events(self, sock, callback, stop_event):
        buffer = ""
        while not stop_event.is_set():
            try:
                chunk = sock.recv(32768)
            except socket.timeout:
                continue
            if not chunk:
                return
            buffer += chunk.decode("utf-8", errors="replace")
            buffer = self._dispatch_json_buffer(buffer, callback)

    def _dispatch_json_buffer(self, buffer, callback):
        while buffer:
            stripped = buffer.lstrip()
            if stripped != buffer:
                buffer = stripped
            if not buffer:
                return ""
            try:
                packet, index = self._decoder.raw_decode(buffer)
            except json.JSONDecodeError:
                if "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    line = line.strip()
                    if line:
                        try:
                            callback(json.loads(line))
                        except Exception:
                            pass
                    continue
                return buffer
            try:
                callback(packet)
            except Exception:
                pass
            buffer = buffer[index:]
        return buffer

