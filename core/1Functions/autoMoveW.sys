## Functions: autoMoveW.sys
#
## Automatically move applications and tab-managers to a specific desk/page
## when they create windows.

## NOTE: With FvwmTabs autoSwallow, that moves applications automatically
## to a tab-manager, check .fvwm/user/Backup/FvwmTabs.conf.
 
## Copy this config to ~/.fvwm/user and edit for your installed apps.

##		APPS		COMMAND			DESK/PAGE/SCREEN LOCATION
## --------------------------------------------------------------------

Style	"FvwmTabs [1]"	StartsOnPage	0 0 0	# desk 0 page
Style	"FvwmTabs [2]"	StartsOnPage	1 0 0	# desk 1 page
Style	"FvwmTabs [3]"	StartsOnPage	2 0 0	# desk 2 page
# Style	*Firefox 		StartsOnPage	0 0 0	# desk 0 page 
# Style	Gimp			StartsOnPage	2 0 0	# desk 2 page
#Style	scribus			StartsOnPage	2 0 0	# desk 2 page
